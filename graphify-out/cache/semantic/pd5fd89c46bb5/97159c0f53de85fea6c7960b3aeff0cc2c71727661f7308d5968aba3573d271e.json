{"nodes": [{"id": "phase2", "label": "Phase 2 Structures: Worldgen & Structures", "file_type": "document", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "phase2_worldgen_structures", "label": "Codex Phase 2: Worldgen & Structures", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minecraft loads packaged JSON registries and compressed NBT templates directly from the mod."}, {"id": "phase2_procedural_plains_village", "label": "Procedural Plains Village (villagefriends:village)", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typical village has 55-140 pieces, ~19 homes and 25-70 residents; all ten new professions appear in every village; new villages appear only in newly generated chunks."}, {"id": "phase2_town_centres", "label": "Town Centres (fountain square, village green, market square)", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "33x33 squares (central_plaza, plaza_green, plaza_market) started at random rotation; hold the notice board, benches, easel, music stand and bell. Plaza templates must keep villagefriends:town_start, painter and bard."}, {"id": "phase2_civic_buildings", "label": "Six Guaranteed Civic Buildings", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tavern, garrison with watchtower, carpenter-and-tailor workshop, chapel with graveyard, apothecary and library house eight of the ten new professions and their workstations."}, {"id": "phase2_street_network", "label": "Random Street Network", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four avenues grow into straights, S-bends, turns, tees, forks, crossroads and well squares; streets end in fading paths, lamp-and-bench ends or a timber gatehouse."}, {"id": "phase2_trade_workshops", "label": "Vanilla Trade Workshops", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smithy, butcher, fletcher, shepherd, fisher, cartographer, mason and tannery give unemployed residents vanilla jobs."}, {"id": "phase2_structure_placement", "label": "Random-Spread Structure Placement", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plains/meadow biomes, spacing 40 chunks, separation 12, salt 18374629, with an exclusion zone around vanilla village candidates; joining the minecraft:village tag lets existing settlement discovery and naming recognize it."}, {"id": "phase2_terrain_adaptation", "label": "Rigid Buildings with Terrain-Matching Streets", "file_type": "rationale", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buildings are rigid so doors and floors stay level; streets follow the ground column by column and become plank bridges over water; beard_thin blends foundations; depth six and 100-block distance bound the village."}, {"id": "phase2_enclosed_bedrooms", "label": "Enclosed Bedrooms", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every home and most civic buildings have a solid enclosed bedroom with real two-part doors, a clear two-block route on each side and matched bed halves, so the future scanner can use layouts as fixtures."}, {"id": "phase2_spatial_bed_scanner", "label": "Future Spatial Bed Scanner", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not implemented; House Plaques instantiate the Phase 1 block entity with empty scan hooks. Doors are treated as room boundaries even when open."}, {"id": "phase2_structure_catalog", "label": "Room/Structure Catalog (structure-catalog.json)", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reproducible catalog recording room bounds, probes, bed feet, doors, fixtures and connectors as future scanner fixtures."}, {"id": "phase2_structures_verification", "label": "Phase 2 Structures Verification", "file_type": "concept", "source_file": "PHASE2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "-PstructuresOnly exercises template loading, rotated bedrooms and door access, fixture block entities, twelve jigsaw assemblies, natural generation, professions/trades, hometown assignment and save/reload."}], "edges": [{"source": "phase2", "target": "building_editing", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE2.md", "source_location": null, "weight": 1.0}, {"source": "phase2_worldgen_structures", "target": "phase1_master_specification", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE2.md", "source_location": null, "weight": 1.0}, {"source": "phase2_worldgen_structures", "target": "phase2_procedural_plains_village", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE2.md", "source_location": null, 