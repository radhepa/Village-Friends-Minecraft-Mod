{"nodes": [{"id": "building_editing", "label": "Editing the Plains Village", "file_type": "document", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "building_editing_independent_templates", "label": "Independent Building Templates", "file_type": "rationale", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every building is one independent template with its own blueprint; improving or replacing one never touches the others and never requires Java edits."}, {"id": "building_editing_village_jigsaw_graph", "label": "Village Jigsaw Graph", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Town centre (random of 3) -> civic slots -> four exits -> avenues -> streets -> lot jigsaws (fallback street_ends and lots_outer), assembled by Minecraft's jigsaw system from ~60 templates."}, {"id": "building_editing_civic_slots", "label": "Civic Slots (priority 5)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each plaza side has a large slot (<=17 wide), a street exit and a small slot (<=11 wide); priority 5 places the six civic buildings before any street can take their space."}, {"id": "building_editing_lots", "label": "Lots (homes, workshops, decorations, empty gaps)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streets at maximum depth only use plains/lots_outer so fields, paddocks and orchards gather on the outskirts; structure_void keeps natural ground in yards."}, {"id": "building_editing_structure_processors", "label": "Structure Processors (worn roads, plank bridges, weathered stone)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "building_editing_village_layout_json", "label": "Village Layout Config (tools/village_layout.json, format 2)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds pools, weights, fallbacks, processors, depth (6), maximum distance (100), biomes, placement, slot_widths and required_pools."}, {"id": "building_editing_design_programs", "label": "Building Design Programs (DESIGNS = {name: function})", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each module in tools/village_design/buildings exposes DESIGNS; design_village.py runs them to write blueprints and --preview writes isometric previews."}, {"id": "building_editing_design_kit", "label": "Village Design Kit (kit.py, parts.py, roads.py)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills neighbour-derived states (fence/pane/wall connections, stair corners) because jigsaw pieces are placed with a known shape; checks every door has two clear blocks on both sides and measures bedrooms by flood fill."}, {"id": "building_editing_layered_blueprints", "label": "Layered JSON Blueprints (tools/village_blueprints)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One blueprint per template recording its design source and checksum; design_village.py never overwrites a hand-edited blueprint without --force, so hand edits are never silently lost. Geometry stays in designs/blueprints, not in the compiler."}, {"id": "building_editing_lot_contract", "label": "Lot Contract (building_entrance jigsaw)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one north-edge villagefriends:building_entrance jigsaw at [x,1,0] (north_up, pool minecraft:empty, final state air, aligned joint); size 3-32; Y=0 is ground; doors need two clear blocks; homes need a recorded enclosed bedroom via b.room."}, {"id": "building_editing_replacement_pools", "label": "Replacement Pools and required_pools", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swap a building by changing its pool entry; the catalog derives required pools from required_pools so tests accept replacements without hard-coded names. Every blueprint must be referenced by a pool; stale NBT is deleted."}, {"id": "building_editing_layout_simulation", "label": "Village Layout Simulation", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "simulate.py imitates jigsaw assembly on flat ground to balance pool weights and detect missing required buildings before testing in Minecraft; Minecraft remains the authority."}, {"id": "building_editing_village_gallery", "label": "In-Game Village Gallery (-PvillageGallery)", "file_type": "concept", "source_file": "BUILDING_EDITING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Places listed templates and whole villages on a superflat world and saves screenshots; a development aid outside the regression suite."}], "edges": [{"source": "phase2_town_centres", "target": "tools_village_design_buildings_plazas", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "phase2_civic_buildings", "target": "tools_village_design_buildings_civic", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "phase2_street_network", "target": "tools_village_design_buildings_streets", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "phase2_street_network", "target": "tools_village_design_roads", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "building_editing_village_jigsaw_graph", "target": "phase2_town_centres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "building_editing_village_jigsaw_graph", "target": "phase2_street_network", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "building_editing_village_jigsaw_graph", "target": "building_editing_lots", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUILDING_EDITING.md", "source_location": null, "weight": 1.0}, {"source": "building_editing_village_jigsaw_graph", "target": "building_editing_civic_slots", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BUILDING_EDITING.md", "source_location": null, "w