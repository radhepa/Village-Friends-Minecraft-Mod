ource_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verification_sims_wardrobe_verification", "label": "Sims-Style Wardrobe Verification (2.7.0)", "file_type": "concept", "source_file": "VERIFICATION.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verification_procedural_village_verification", "label": "Procedural Plains Village Verification", "file_type": "concept", "source_file": "VERIFICATION.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verification_male_starter_texture_verification", "label": "Male Starter Texture Rebuild Verification", "file_type": "concept", "source_file": "VERIFICATION.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verification_male_registry_phase_2_verification", "label": "Male Asset Registry Phase 2 Verification", "file_type": "concept", "source_file": "VERIFICATION.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verification_outfit_engine_phase_1_verification", "label": "Outfit Engine Phase 1 Verification", "file_type": "concept", "source_file": "VERIFICATION.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The previous wardrobe source, preset catalogs, semantic-mask assets, generators and obsolete tests were deleted; earlier wardrobe verification claims were retired with that implementation."}, {"id": "verification_srgb_framebuffer_workaround", "label": "SDL sRGB Framebuffer Workaround", "file_type": "rationale", "source_file": "VERIFICATION.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDL asks for an sRGB-capable framebuffer that Xvfb does not offer, so the Linux software-rendered client ran with SDL_OPENGL_FORCE_SRGB_FRAMEBUFFER=skip."}, {"id": "verification_stale_hair_json_drift", "label": "Stale Hair JSON Float Drift on Linux", "file_type": "rationale", "source_file": "VERIFICATION.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wardrobe.py --check reports 11 hair JSON files stale on Linux before and after the change; they differ only in the last digit of some floating-point pivots (pre-existing platform float drift, not a regression)."}, {"id": "verification_unregistered_archetype_outfits", "label": "Outfits Under Unregistered Archetypes", "file_type": "rationale", "source_file": "VERIFICATION.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A first 2.11 run found two women's outfits listed only under the unregistered Merchant/Mage archetypes; they were given real jobs and the compiler now rejects such outfits."}, {"id": "verification_gametest_shutdown_hang", "label": "Client Game-Test Shutdown Hang", "file_type": "rationale", "source_file": "VERIFICATION.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A run hung in Fabric's client game-test shutdown (render thread halting the integrated server while the test thread waited on the tick phaser); the test now settles for 40 ticks before closing the world."}, {"id": "verification_roadmap_recovery_timing_flake", "label": "Roadmap Companion Recovery Timing Flake", "file_type": "rationale", "source_file": "VERIFICATION.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The client waits a fixed 1,220 ticks for one-minute companion recovery while the software-rendered server fell about 160 ticks behind; the same suite passed on main and on rerun."}], "edges": [{"source": "