{"nodes": [{"id": "readme", "label": "Village Friends README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_village_friends_mod", "label": "Village Friends 2.12.0 Fabric Mod", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Villagers get names, preferences, persistent memories, personal stories and player-shaped looks; conversations work offline with no AI account or service fees."}, {"id": "readme_conversation_window", "label": "Conversation Window (Talk/Story/Journal/Time/Travel tabs)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the wood-and-parchment design with a live resident portrait; dialogue types out with soft blips and residents speak in wordless hums instead of vanilla villager sounds."}, {"id": "readme_wordless_hum_voices", "label": "Wordless Human-like Hum Voices", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_relationship_tiers", "label": "Relationship Tiers (New Neighbor to Best Friend)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Points stop at 200 and gifts alone cannot unlock upper tiers; Friend and above also require shared history (shared experience, confession, completed story) so stories and activities drive progression rather than repeated gifting. No penalty for taking a break."}, {"id": "readme_personal_stories", "label": "Four-Chapter Personal Stories", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stories progress through experiences and visits on different Minecraft days (confession after three visiting days; ending after five days and 60 trust); there are no request deadlines."}, {"id": "readme_content_json", "label": "Narrative Content Pack (content.json)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All personalities, story arcs, requests, gift preferences and dialogue live in data so authored text can expand without rewriting Java; /reload validates it and invalid packs keep the previous working definitions."}, {"id": "readme_gifts_and_promises", "label": "Gifts and Promises", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three gifts per player per day; rejected gifts consume neither item nor allowance. Withdrawing a promise costs five trust, harming a resident 15; apologies begin repair and story milestones stay recorded."}, {"id": "readme_shared_activities", "label": "Shared Activities (Walk, Picnic, Exploration, Gathering)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlock at 15 points and 30 trust; occupy the single companion slot while active and award points/trust once per day."}, {"id": "readme_resident_connections", "label": "Resident-to-Resident Connections", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to 16 persistent connections that grow with shared hobbies and values from spending days near each other."}, {"id": "readme_adventure_companions", "label": "Adventure Companions (Follow/Wait/Return home)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One companion per player and one owner per resident; Overworld only, no portals, and pathfinding never builds bridges or alters terrain."}, {"id": "readme_downed_companion_rescue", "label": "Downed Companion Rescue", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lethal injury leaves a recruited companion downed with identity and equipment intact; after one minute without rescue they recover at home and remember the interrupted outing."}, {"id": "readme_persistent_resident_identity", "label": "Persistent Resident Identity (stable ID)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable ID independent of entity UUID and profession; zombie conversion/curing transfers identity, relationships, outcomes and names."}, {"id": "readme_per_player_coop_state", "label": "Per-Player Co-op Relationship State", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Affection, trust, visits, choices and memories belong to each player; physical requests belong to the resident and the first supplier keeps credit. The server validates choices, quests, recruitment and exchanges."}, {"id": "readme_hometowns", "label": "Hometown Names and Settlements", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each resident keeps their first assigned hometown; renaming a village updates the suffix without changing identity."}, {"id": "readme_village_marker", "label": "Village Marker", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Player-built settlements opt in via a placed marker (96-block radius); breaking it never deletes the settlement and no markers or terrain edits are placed automatically."}, {"id": "readme_child_villagers", "label": "Child Villager Appearance", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Children use a child model and play clothes; adult looks are revealed on growing up while identity and memories stay intact."}, {"id": "readme_sims_style_wardrobe", "label": "Sims-style Men's and Women's Wardrobes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Palette-locked pixel art with 3D pieces; tops and bottoms mix freely except locked one-piece outfits; hair is chosen once per resident so a new job never changes it."}, {"id": "readme_master_palettes", "label": "Ten Master Palettes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One palette colors the whole outfit (primary, secondary, accent, leather, metal, ink) with hand-shaded ramps."}, {"id": "readme_living_villagers", "label": "Living Villagers (walking styles, breathing, articulated eyes)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six subtle walking styles, blinking/glancing eyes in each resident's original eye colors; clothing and armor follow the movement."}, {"id": "readme_village_life_animation_pack", "label": "Village Life Animation Pack (99 clips)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residents choose clips moment to moment (idles, trade work, hobbies, chats, greetings, reactions, weather); resource packs can add more packs."}, {"id": "readme_romance_family_milestone", "label": "Milestone 7: Romance and Family (future)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred until the friendship systems have been used in real worlds."}], "edges": [{"source": "readme", "target": "phase1", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "phase2", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "building_editing", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "guards", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "outfit_engine", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "animation_editing", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "animation_packs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RE