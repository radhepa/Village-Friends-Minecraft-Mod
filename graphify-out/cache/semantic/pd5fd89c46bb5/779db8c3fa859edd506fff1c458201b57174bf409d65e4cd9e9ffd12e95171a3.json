{"nodes": [{"id": "phase1", "label": "Phase 1 Implementation: Registry & Item Foundation", "file_type": "document", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "phase1_master_specification", "label": "Master Specification (Codex roadmap)", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External specification supplying the Codex Phase 1 and Phase 2 roadmaps; where it gave no recipe the mod supplies initial ones."}, {"id": "phase1_registry_item_foundation", "label": "Codex Phase 1: Registry & Item Foundation", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register professions, POIs, blocks, items and block entity types with usable assets, and expose hooks for later controllers; uses vanilla job acquisition/trading and the existing resident entity, so no new entity type is needed."}, {"id": "phase1_registration_order", "label": "Registration Order (blocks, items, block entities, professions)", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VillageFoundation.register() runs from VillageFriends.onInitialize() before narrative content loading."}, {"id": "phase1_ten_professions", "label": "Ten New Professions and Workstations", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knight, Archer, Cook, Tavern Keeper, Apothecary, Painter, Bard, Tailor, Carpenter, Scholar. Each workstation is a job POI (one ticket, range one) tagged acquirable_job_site; Sewing Tables and Archives are distinct anchors so vanilla looms, lecterns and barrels keep their original professions."}, {"id": "phase1_native_trades", "label": "Native Trade Sets (50 sets, 100 offers)", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two offers per profession level across five levels; prices are initial balance choices editable in data/villagefriends/trade_set."}, {"id": "phase1_new_blocks", "label": "17 New Foundation Blocks", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eleven workstations plus Village Bench, Campfire Bench, Apothecary Cot, House Plaque, Notice Board and Command Desk; four facing states, matching collision, recipe, loot. Benches declare planned capacity two (BENCH_CAPACITY); seating is later work."}, {"id": "phase1_new_items", "label": "24 New Items and 41 Recipes", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Medical supplies, coffee mugs, bread, stew, rain gear, ten profession uniforms and five tool props; tools are registered handheld props whose behaviors are future systems."}, {"id": "phase1_meal_consumables", "label": "Bread, Stew and Coffee Consumables", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bread heals two, stew heals six and returns a bowl, coffee grants Speed I for 30s and returns its mug; effects run on the server."}, {"id": "phase1_wearable_uniforms", "label": "Wearable Uniforms and Rain Gear", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve chest-slot wearables with no armor protection; can be given to companions via Travel -> Equip held item."}, {"id": "phase1_integration_hooks", "label": "Empty Block Entity Integration Hooks", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HousePlaque scanForBeds/scanForWorkstations, NoticeBoard refreshNotices, CommandDesk updatePatrolAssignments/refreshGuardRoster, ApothecaryCot updatePatient are intentionally empty with no tickers; housing, notice, patrol and patient state should get a versioned persistence schema when implemented."}, {"id": "phase1_medical_treatment_contract", "label": "Medical Treatment Contract", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MedicalSupplyItem.treatment(): Smelling Salts restore 0.20 max health, Revival Tonic 1.00, Bandage Wrap adds 12 real-time hours. Items do not revive yet; the controller should validate the patient, apply on the server and consume only on success."}, {"id": "phase1_knockout_controller", "label": "Future Real-Time Knockout Controller", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planned system that will consume the medical treatment contract; the existing companion rescue/recovery behavior is retained meanwhile."}, {"id": "phase1_foundation_asset_generator", "label": "Foundation Asset Generation Pipeline", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "create_foundation_assets.py reads block geometry and profession IDs from Java and reproduces Phase 1 assets with Python + Pillow; players need neither Python nor an art service, and final Blockbench models can replace assets at the same IDs. It and create_village_marker.py merge shared language/axe-tag files to preserve each other's content."}, {"id": "phase1_foundation_catalog", "label": "Foundation Catalog (foundation-catalog.json)", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documentation data for verification/integrations rather than a reloadable registry configuration."}, {"id": "phase1_foundation_gametest", "label": "Phase 1 Foundation Gameplay Verification", "file_type": "concept", "source_file": "PHASE1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FoundationGameTest runs first and validates registry/POI loading, recipes, exact potion matching, trades, placement/drops, natural acquisition of all ten professions and save/reload; focused via -PfoundationOnly."}], "edges": [{"source": "phase1", "target": "phase2", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1.md", "source_location": null, "weight": 1.0}, {"source": "phase1", "target": "outfit_engine", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1.md", "source_location": null, "weight": 1.0}, {"source": "phase1_registry_item_foundation", "target": "phase1_master_specification", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PHASE1.md", "source_location": null, "weight": 1.0}, {"source": "src_main_java_dev_villagefriends_villagefoundation_villagefoundation", "target": "phase1_registry_item_foundation", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PHASE1.md", "source_location": null, "weight": 1.0}, {"source": "src_main_java_dev_villagefriends_villagefriends_villagefriends", "target": "src_main_java_dev_villagefrien