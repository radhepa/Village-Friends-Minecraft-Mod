{"nodes": [{"id": "animation_editing", "label": "ANIMATION_EDITING.md (Resident movement, animation packs and eyes)", "file_type": "document", "source_file": "ANIMATION_EDITING.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_always_on_motion", "label": "Always-On Motion Layer", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Individual gaits, breathing, weight shift, drifting head, forward lean when hurrying, blinking and glances; renderer-only, never changing AI, hitboxes, speed or saved appearances."}, {"id": "animation_editing_gait_styles", "label": "Six Gait Styles", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The resident's UUID selects its gait so job changes and world reloads keep the same movement identity; gaits are independent of complexion and clothing, and the walk stays small (sway under two degrees, twist about 1.5 degrees)."}, {"id": "animation_editing_armor_parity", "label": "Armor Pose Parity", "file_type": "rationale", "source_file": "ANIMATION_EDITING.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gait and clip poses are applied to both ResidentModel and ResidentArmorModel through the same code, so armor never walks out of alignment or separates from a pose."}, {"id": "animation_editing_pose_layer_order", "label": "Clip Pose Layering Order (limbs, waist, root)", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_activity_reaction_layers", "label": "Activity and Reaction Layers", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_clip_rules", "label": "Clip Editing Rules", "file_type": "rationale", "source_file": "ANIMATION_EDITING.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clips start and end at rest; positions are written in adult pixels and scaled for children; posing allocates nothing per frame and never touches textures."}, {"id": "animation_editing_temperament_attachment", "label": "villagefriends:temperament Synced Attachment", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syncs the resident's personality to the client so body language matches the Journal."}, {"id": "animation_editing_starlit_eyes", "label": "Starlit Eyes", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_soft_glint_eyes", "label": "Soft Glint Eyes", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_face_swatches", "label": "Face Detail Swatches (64..71, 0)", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brow, lash, neck shade, tinted upper white, pupil, lips and blush are baked from the resident's own eye row, so resource packs that recolor the eye row recolor the whole eye."}, {"id": "animation_editing_gendered_face_details", "label": "Masculine and Feminine Face Details", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faces are young and clean (no nose, eye bags or chin shadow). Women always wear the feminine details, men never, and non-binary residents get one or the other from their seed."}, {"id": "animation_editing_blink_and_glance", "label": "Blink and Glance Mechanics", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lash line sweeps down with a skin lid following; glances are trimmed to the eye's edges; no random draws, timer allocations, extra skin images or texture uploads per frame."}, {"id": "animation_editing_animations_only_gametest", "label": "-PanimationsOnly Game Test", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_editing_animation_pack_gametest", "label": "-PanimationPack Game Test", "file_type": "concept", "source_file": "ANIMATION_EDITING.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "animation_editing", "target": "animation_packs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANIMATION_EDITING.md", "source_location": "L6", "weight": 1.0}, {"source": "animation_editing", "target": "animation_editing_always_on_motion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANIMATION_EDITING.md", "source_location": "L5", "weight": 1.0}, {"source": "animation_editing_always_on_motion", "target": "src_client_java_dev_villagefriends_client_residentanimation_residentanimation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANIMATION