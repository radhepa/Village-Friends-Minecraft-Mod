{"nodes": [{"id": "outfit_engine", "label": "OUTFIT_ENGINE.md (Wardrobe and outfit engine)", "file_type": "document", "source_file": "OUTFIT_ENGINE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_sims_style_wardrobe", "label": "Sims-Style Wardrobe", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residents dress like characters from a Sims-style wardrobe: within a resident's set any top pairs with any bottom unless a rule forbids it. It replaced the previous voxel/role-mask wardrobe and its registries at the user's request."}, {"id": "outfit_engine_mens_wardrobe_set", "label": "Men's Wardrobe Set", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "80 hairstyles, 120 tops and 120 bottoms. The original 90 pieces (first ten of each kind from the user's male reference plus the 2.8 casual-medieval and anime additions) became the men's set in 2.11."}, {"id": "outfit_engine_womens_wardrobe_set", "label": "Women's Wardrobe Set", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First women's wardrobe (2.11): 50 hairstyles and 60 tops and bottoms (kirtles, bodices, chemises, overgowns, aprons, skirts, breeches, armor) with an outfit for every profession."}, {"id": "outfit_engine_supreme_casual_line", "label": "Supreme Casual Line", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twenty-piece line of plain tees, tunics, polos, shirts, chinos, slacks and jeans; the one deliberate exception to the medieval cut, requested by the user and kept plain with no prints or logos."}, {"id": "outfit_engine_anime_hairstyles", "label": "Anime-Inspired Hairstyles", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clean cel shading, a sheen ring and tapered pointed locks, but grounded: no gravity-defying spikes."}, {"id": "outfit_engine_wardrobe_piece", "label": "Wardrobe Piece (PNG + JSON)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_skin_layer", "label": "Skin Layer (64x64 player-skin layout)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The base layer is the body; hat, jacket, sleeve and pants overlays give clothing and hair half-pixel depth."}, {"id": "outfit_engine_3d_pieces", "label": "3D Pieces (box-UV cuboids on bones)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_piece_motion", "label": "Piece Motion (flap_front, flap_back, sway)", "file_type": "rationale", "source_file": "OUTFIT_ENGINE.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flaps follow the leading or trailing leg so coats and aprons never clip through a stride; sway swings ponytails, tassels and sash tails while walking."}, {"id": "outfit_engine_palette_lock", "label": "Palette Lock", "file_type": "rationale", "source_file": "OUTFIT_ENGINE.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PNGs contain no clothing color; every opaque pixel is a key color resolved through one palette per Outfit, so any outfit can be recolored and pixel-art shading always stays within the palette."}, {"id": "outfit_engine_key_color", "label": "Key Color (role + shade)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A role (primary 60%, secondary 30%, accent 10%, leather, metal, ink, denim, or natural hair) plus one of five shades (deep, shadow, base, light, highlight)."}, {"id": "outfit_engine_master_palettes", "label": "Ten Master Palettes (palettes.json)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five-shade ramps where shadows shift cooler and highlights warmer so pixel-art shading stays within the palette; each palette has its own tone of every material."}, {"id": "outfit_engine_denim_material_role", "label": "Denim Material Role", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each palette carries its own denim wash so jeans read as denim while still matching the outfit."}, {"id": "outfit_engine_plain_colorways", "label": "Plain Colorways", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain garment takes its color from the role it is painted in; one cut in five roles yields five differently colored shirts in every palette."}, {"id": "outfit_engine_natural_hair_colors", "label": "Natural Hair Color Ramps", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hair keys resolve through one of ten natural HairColor ramps rather than the outfit palette."}, {"id": "outfit_engine_shadow_keys", "label": "Shadow Keys (X1/X2)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_mix_and_match", "label": "Mix-and-Match Compatibility Rule", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every free top mixes with at least seven free bottoms; 9,849 of 10,201 men's and 2,665 of 2,704 women's free pairs are allowed. Java and the Python compiler apply the same rule."}, {"id": "outfit_engine_tag_rules", "label": "Tag Rules (require/reject)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_locked_sets", "label": "Locked Sets (locked_to)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some outfits only work as one piece (e.g. gowns whose bodice and skirt share trim); top and bottom name each other and are always worn whole. 19 men's and 8 women's sets."}, {"id": "outfit_engine_skin_layer_stacking", "label": "Skin Layer Stacking (tucked, coversWaist)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Body, bottom, top, hair; a tucked top goes under the bottom so waistbands and suspenders show over it, and a top that coversWaist hides the bottom's waist pieces."}, {"id": "outfit_engine_outfit_templates", "label": "Outfit Templates", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_wardrobe_catalog", "label": "Wardrobe Catalog (catalog.json)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_profession_dressing", "label": "Profession Dressing Order (assembleOutfit)", "file_type": "rationale", "source_file": "OUTFIT_ENGINE.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hair and hair color come from the resident's seed alone so a new job never changes them; the preferred template is chosen 30% of the time and the template bottom kept 50% so villages show more of the wardrobe. Unknown or modded professions dress like the unemployed."}, {"id": "outfit_engine_worn_piece_posing", "label": "Worn-Piece-Only Posing", "file_type": "rationale", "source_file": "OUTFIT_ENGINE.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pieces are baked once as plain cubes and only the worn hair, top and bottom are placed each frame, so frame cost does not grow with the wardrobe: about 8 us per resident versus 67 us (paid twice per frame) when every piece lived in the model."}, {"id": "outfit_engine_atlas_slot_layout", "label": "Shared Per-Kind Atlas Slots (256x512)", "file_type": "rationale", "source_file": "OUTFIT_ENGINE.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An outfit wears one garment of each kind, so all garments of a kind share one 64-pixel-wide slot and the wardrobe grows without growing the texture."}, {"id": "outfit_engine_skin_baking", "label": "Per-Outfit Skin Baking", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One texture per complexion and outfit is baked on a cache miss; animation allocates no textures."}, {"id": "outfit_engine_wardrobe_reload", "label": "Resource-Pack Wardrobe Reload", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wardrobe PNGs reload with resource packs, so a pack can repaint any piece in key colors."}, {"id": "outfit_engine_armor_hiding", "label": "Armor Hiding of Wardrobe Pieces", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_living_eyes", "label": "Living Eyes (protected eye row)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hair never paints the eye row and the compiler rejects fringes that would hang over the eyes or mouth, keeping eyes readable and animatable."}, {"id": "outfit_engine_appearance_recipe", "label": "Appearance Recipe (outfitN:complexion:GENDER:PALETTE_ID:seed)", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved residents keep complexion, gender, palette, seed, identity and history and are redressed from the expanded wardrobe."}, {"id": "outfit_engine_gender_fallback", "label": "Gendered Wardrobe Lookup and Fallback", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_outfits_only_gametest", "label": "-PoutfitsOnly Game Test", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_hair_faces_only_gametest", "label": "-PhairFacesOnly Game Test", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "outfit_engine_resident_sample", "label": "-PresidentSample Development Sample", "file_type": "concept", "source_file": "OUTFIT_ENGINE.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A development sample rather than a regression test: dresses five random men and five random women exactly as a new village would; -PsampleSeed repeats a draw."}], "edges": [{"source": "outfit_engine", "target": "wardrobe_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OUTFIT_ENGINE.md", "source_location": "L10", "weight": 1.0}, {"source": "outfit_engine", "target": "animation_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OUTFIT_ENGINE.md", "source_location": "L100", "weight": 1.0}, {"source": "outfit_engine", "target": "outfit_engine_sims_style_wardrobe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OUTFIT_ENGINE.md", "source_location": "L3", "weight": 1.0}, {"source": "outfit_engine", "target": "src_test_java_dev_villagefriends_outfitenginetest_outfitenginetest", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "OUTFIT_ENGINE.md", "source_location": "L112", "weight": 1.0}, {"source": "outfit_engine_sims_style_wardrobe", "target": "outfit_engine_mens_wardrobe_set", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "OUTFIT_ENGINE.md", "source_location": "L3", "weight": 1.0}, {"source": "outfit_engine_sims_sty