{"nodes": [{"id": "guards", "label": "Knights and Archers Guide", "file_type": "document", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "guards_village_defense", "label": "Automatic Village Defense (Knights and Archers)", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knights use swords; archers fire bows and retreat within four blocks. Guards scan 16 blocks twice a second; idle guards keep ordinary jobs, trades, sleep and social behavior; children and NoAI residents do not fight."}, {"id": "guards_villager_predators_tag", "label": "villager_predators Entity Tag", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data-pack replaceable target list (zombies, illagers, ravagers, zoglins...); creepers are always excluded and idle player-hostile mobs are not targets."}, {"id": "guards_friendship_forgiveness", "label": "Friendship Forgiveness for Player Hits", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unforgiven hits on any villager alert guards within 16 blocks; forgiveness requires the victim's effective Friend tier, and friendship with the responding guards does not excuse harming a different resident. Forgiven hits still cost trust."}, {"id": "guards_pursuit_limits", "label": "Guard Pursuit Limits", "file_type": "rationale", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggressors are remembered 60 seconds; combat stays within 32 blocks of the starting point; guards never load distant chunks, teleport, build bridges or clear terrain, and anger clears on unload/restart."}, {"id": "guards_initial_equipment", "label": "Initial Guard Equipment (UUID-selected iron/chainmail)", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weapon plus four armor pieces, exactly two iron and two chainmail chosen by UUID; a saved marker prevents regeneration on reload, conversion, upgrade or breakage."}, {"id": "guards_spawn_eggs", "label": "Knight and Archer Spawn Eggs", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create ordinary equipped adult villagers at generated level 15-30; one point of trading XP keeps their jobs without workstations; no Survival recipe."}, {"id": "guards_guard_progression", "label": "Guard Level Progression (0-50)", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combat level independent of trading and friendship; each level adds 0.2 max HP and 0.5% damage while speed, cooldowns, draw time, accuracy and armor stay vanilla so equipment upgrades remain valuable. Advancing from L needs 20 + 3L XP; generated guards start at a UUID-seeded 15-30, newly trained guards at 0."}, {"id": "guards_damage_based_xp_credit", "label": "Damage-Based Guard XP Credit", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XP is awarded only on death, split by actual health damage dealt in the preceding 30 seconds; players and other damage take their share of the denominator, and contributions clear on unload/restart."}, {"id": "guards_combat_profession_lock", "label": "Combat Profession Lock", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first qualifying killing blow (including by its arrows) permanently locks the Knight or Archer role; assists do not lock."}, {"id": "guards_equipment_exchange", "label": "Guard Equipment Exchange (Equip held item)", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peaceful players may swap a guard's weapon/armor without friendship; recruited guards accept only their owner. One physical item is consumed even in Creative and the previous piece is returned."}, {"id": "guards_unlimited_safe_arrows", "label": "Unlimited Safe Archer Arrows", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Archers have uncollectable unlimited arrows; they check the firing path and arrows cannot injure villagers, iron golems or non-target players; arrows remember the guard level when fired."}, {"id": "guards_future_work", "label": "Patrols, Command Desk Controls and Shields (future)", "file_type": "concept", "source_file": "GUARDS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "guards_village_defense", "target": "src_main_java_dev_villagefriends_guardcontroller_guardcontroller", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "GUARDS.md", "source_location": null, "weight": 1.0}, {"source": "guards_village_defense", "target": "src_main_java_dev_villagefriends_guardpolicy_guardpolicy", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "GUARDS.md", "source_location": null, "weight": 1.0}, {"source": "guards_village_defense", "target": "src_main_ja