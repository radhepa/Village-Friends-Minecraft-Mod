{"nodes": [{"id": "wardrobe_editing", "label": "WARDROBE_EDITING.md (Editing the wardrobe)", "file_type": "document", "source_file": "WARDROBE_EDITING.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wardrobe_editing_piece_module", "label": "Piece Module (META + build(g))", "file_type": "concept", "source_file": "WARDROBE_EDITING.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each hairstyle, top and bottom is one self-contained Python module so it can be replaced on its own; a piece's identity (lacing, trim, silhouette) stays in its own module."}, {"id": "wardrobe_editing_shared_building_blocks", "label": "Shared Building Blocks (kit.py, anime.py)", "file_type": "concept", "source_file": "WARDROBE_EDITING.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared shapes live in kits so a module only describes what makes its piece distinctive; kits paint key colors only and return their boxes so modules can add details on top."}, {"id": "wardrobe_editing_layering_depth", "label": "Layering Depth Z-Offsets", "file_type": "rationale", "source_file": "WARDROBE_EDITING.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top hems and flaps sit at z -2.85/1.85, skirt and kilt panels just outside at -2.95/1.95 so a top's hem reads as tucked in, and over-layers (aprons, tabards) at -3.15/2.15."}, {"id": "wardrobe_editing_style_targets", "label": "Wardrobe Style Targets", "file_type": "rationale", "source_file": "WARDROBE_EDITING.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Casual medieval village wear with no modern cuts (except supreme casual); calm structured cloth and deliberate details over random noise; hair broken into several smaller locks because one big slab reads as a helmet."}, {"id": "wardrobe_editing_compiler_rules", "label": "Compiler-Enforced Wardrobe Rules", "file_type": "concept", "source_file": "WARDROBE_EDITING.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wardrobe_editing_eye_clearance_rule", "label": "Fringe Eye-Clearance Rule", "file_type": "concept", "source_file": "WARDROBE_EDITING.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In front of the face any part of a lock within |x| < 3 must end above y = -5, so long sidelocks and outer bangs sit at |x| >= 4.1; a fringe may reach the brows but never cover eyes, nose or mouth."}, {"id": "wardrobe_editing_template_coverage_rule", "label": "Template Coverage Rule", "file_type": "rationale", "source_file": "WARDROBE_EDITING.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every top must appear in at least one outfit template because residents choose tops through their profession's templates; every free top mixes with at least seven free bottoms (four for armor); a gender with any templates must dress every profession."}, {"id": "wardrobe_editing_add_variant_workflow", "label": "Add-a-Variant Workflow", "file_type": "concept", "source_file": "WARDROBE_EDITING.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The catalog and tests derive their lists from the compiled output, so adding a variant needs no Java changes."}], "edges": [{"source": "wardrobe_editing", "target": "outfit_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "WARDROBE_EDITING.md", "source_location": "L3", "weight": 1.0}, {"source": "wardrobe_editing", "target": "wardrobe_editing_piece_module", "relation": 