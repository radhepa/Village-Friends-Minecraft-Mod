{"nodes": [{"id": "animation_packs", "label": "ANIMATION_PACKS.md (Resident animation packs)", "file_type": "document", "source_file": "ANIMATION_PACKS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_animation_pack", "label": "Animation Pack", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packs are client resources that only describe motion; the director decides when each clip plays, and nothing about animation is saved in worlds or sent to the server."}, {"id": "animation_packs_clip", "label": "Animation Clip", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_village_life_pack", "label": "Village Life Pack", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundled first pack: 99 clips (90 distinct motions) covering everyday idles, one hobby per personality, work for every profession, greetings, talking, neighbor chats, reactions, weather and children."}, {"id": "animation_packs_director", "label": "Resident Animation Director", "file_type": "rationale", "source_file": "ANIMATION_PACKS.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side per-resident director: rests after a clip (shorter for lively personalities and children) and never repeats the last two clips if anything else fits, so residents feel self-directed."}, {"id": "animation_packs_clip_triggers", "label": "Clip Triggers (idle, chat, greet, talk, reactions, hurt)", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_eligibility_tags", "label": "Clip Eligibility Tags", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_left_handed_mirroring", "label": "Left-Handed Mirroring", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About one resident in nine is left-handed and mirrors one-handed gestures (clip mirror mode hand/free/never)."}, {"id": "animation_packs_pack_file_format", "label": "Animation Pack JSON Format (format 1)", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_pack_override", "label": "Pack Replacement and Disable", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Later packs replace clips with the same name and a disable list switches clips off; a pack that fails validation is skipped and named in the log while the others still load."}, {"id": "animation_packs_tracks", "label": "Animation Tracks (bone.rot, bone.pos, eyes.lid, eyes.look)", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_monotone_curves", "label": "Smooth Monotone Interpolation", "file_type": "rationale", "source_file": "ANIMATION_PACKS.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values between keys never overshoot a key and hold still between equal keys; tracks start and end at zero so clips blend cleanly."}, {"id": "animation_packs_waist_bone", "label": "Waist Bone", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bends the body, head and both arms together at the hips (rotation only) so bows keep the feet planted."}, {"id": "animation_packs_root_bone", "label": "Root Bone", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "animation_packs_python_authoring", "label": "Python Clip Authoring (mirror-friendly kit)", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundled pack is authored in Python with mirror-friendly conventions (both arms lift outward with positive roll) converted to model space; the compiled JSON is never hand-edited."}, {"id": "animation_packs_animation_video", "label": "-PanimationVideo Showcase", "file_type": "concept", "source_file": "ANIMATION_PACKS.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development only: builds a procedural village on a superflat world and steps a frozen world one tick per frame, rendering between ticks, so footage is smooth and repeatable."}], "edges": [{"source": "animation_packs", "target": "animation_packs_animation_pack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANIMATION_PACKS.md", "source_location": "L3", "weight": 1.0}, {"source": "animation_packs", "target": "tools_animations_preview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANIMATION_PACKS.md", "source_location": "L118", "weight